<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome to Ghost Forum"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp" />
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Private Forum &amp; Messenger"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="48dp"
        android:textColor="@android:color/darker_gray" />
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect your Ethereum wallet to initialize your private identity"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />
    
    <Button
        android:id="@+id/connectWalletButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect Wallet"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />
    
    <Button
        android:id="@+id/continueButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Continue"
        android:textSize="18sp"
        android:layout_marginBottom="32dp" />
    
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to connect"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@android:color/darker_gray" />
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All data is encrypted and stored securely. No metadata about your activities or conversations will be collected."
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:textColor="@android:color/darker_gray" />
    
</LinearLayout>