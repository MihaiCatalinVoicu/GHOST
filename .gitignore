# Build outputs
build/
target/
out/
*.apk
*.aab
*.ap_
*.dex
*.class

# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.jar
local.properties

# Rust
**/target/
# ... except the gate fixtures whose point is a module directory named `target` (the source finders once
# pruned every such directory unread; Phase 10 review of S2a F4, whose two fixtures were ignored by the
# rule above and never committed, found by the review of S1a).
!ghost/test-harness/gates/**/target/
Cargo.lock.orig
# Gate fixtures the build-output patterns above would hide (scripts/gates/self-test.sh): module
# directories named `target` or `build` under a `src/`, which the gates must read as code (Phase 10
# review of S2a F4), and the one build output the surface gates must prune (review of S2b). Two S2a
# fixtures were never committed because of these patterns, and the self-test failed on a clean tree.
!ghost/test-harness/gates/**/src/target/
!ghost/test-harness/gates/**/src/build/
!ghost/test-harness/gates/mls-jni/evasions/target/

# IDE
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Secrets and local state — never commit
*.keystore
*.jks
*.pem
*.p12
*.env
.env*
# exception: the Phase 12 lyrebird pin file is data, not secrets (BUILD.sh sources it)
!ghost/third_party/lyrebird/pins.env
secrets/
**/local.secrets.*
# Entitlement operator material (Phase 8 runbooks K1/K3): Tor onion service secret keys
# (ghost-issuer-ops onion-keygen), sealed key files, key load files, the custody secret and the
# schedule key live outside the repository (%USERPROFILE%\.ghost-stagenet-keys\ for stagenet).
# The committed test fixtures of these kinds were added with `git add -f`.
hs_ed25519_secret_key
*.ghks
*.ghkl
custody.secret
schedule.key

# Temporary
*.log
*.tmp
.temp/
.kotlin/
build-repro/
**/jniLibs/
ghost/native-libs.sha256
.claude/worktrees/

# Phase 12 lyrebird build area (fetched at build time; see ghost/third_party/lyrebird/BUILD.sh)
ghost/third_party/lyrebird/toolchain/
ghost/third_party/lyrebird/.cache/
