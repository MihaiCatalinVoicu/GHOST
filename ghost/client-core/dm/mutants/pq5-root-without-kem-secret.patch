# PQ5's PQ-C half (design §9.4, RG-5): `seal_root_pq`'s root derived without the X-Wing secret, on
# both sides: `HKDF(root_rand || 0^32, salt)`. The TLV keeps its 1 120-byte ciphertext, both sides
# still derive one root and the pair envelopes under it open, so the root is only as strong as the
# classical layer that carried `root_rand`. PQ5 re-derives the root from an independent decapsulation.
# kills: pq_bump::pq5_every_seal_root_pq_carries_an_x_wing_ciphertext_its_root_depends_on
diff --git a/ghost/client-core/dm/src/derive.rs b/ghost/client-core/dm/src/derive.rs
index 573438d..72846f6 100644
--- a/ghost/client-core/dm/src/derive.rs
+++ b/ghost/client-core/dm/src/derive.rs
@@ -386,7 +386,8 @@ pub fn derive_pq_root(
         .into();
     let mut ikm = [0u8; 2 * SECRET_BYTES];
     ikm[..SECRET_BYTES].copy_from_slice(root_rand.as_bytes());
-    ikm[SECRET_BYTES..].copy_from_slice(shared_secret.as_bytes());
+    // MUTANT (PQ5): the PQ-C root without the X-Wing secret.
+    let _ = shared_secret;
     let root = PairRoot::from_bytes(hkdf32(&ikm, Some(&salt), PQ_ROOT_LABEL.as_bytes()));
     ikm.zeroize();
     root
