# PM-32 (design §15.7): the intro inner layer keyed without the X-Wing KEM, on both sides.
# `k_in = HKDF(T_in, 0^32)`: the seal still encapsulates and the open still decapsulates, so the
# envelope keeps its 1 120-byte ciphertext and exactly one decapsulation per open, and the world
# works: sender and recipient agree. T35 cannot see it (k_in is never a SealKey, §22.16 item 18).
# kills: pq_bump::pq1_every_intro_open_of_the_world_decapsulates_exactly_once
# kills: pq_bump::pq1_k_in_depends_on_the_decapsulated_secret_in_every_intro_open
# kills: pq_bump::pq1_the_host_assertion_passes_every_open_of_the_world
# kills: pq_bump::pq5_every_intro_envelope_carries_an_x_wing_ciphertext_whose_secret_keys_its_inner_layer
# kills: pq_bump::pq5_the_sender_keys_the_inner_layer_with_the_secret_its_ciphertext_carries
# kills: pq_bump::pq5_a_gate_variant_client_sealing_without_the_kem_is_refused_by_an_honest_recipient
diff --git a/ghost/client-core/dm/src/seal.rs b/ghost/client-core/dm/src/seal.rs
index 05d576b..a8d7f50 100644
--- a/ghost/client-core/dm/src/seal.rs
+++ b/ghost/client-core/dm/src/seal.rs
@@ -626,7 +626,9 @@ pub fn intro_transcript(context: &IntroContext<'_>, ciphertext: &[u8]) -> [u8; 3
 /// `k_in`, wiped when it goes out of scope (§2.4 point 1).
 fn intro_inner_key(shared: &KemSecret, transcript: &[u8; 32]) -> Zeroizing<[u8; 32]> {
     let mut out = Zeroizing::new([0u8; 32]);
-    Hkdf::<Sha256>::new(Some(transcript), shared.as_bytes())
+    // MUTANT (PM-32): k_in without the X-Wing secret, on both sides.
+    let _ = shared;
+    Hkdf::<Sha256>::new(Some(transcript), &[0u8; 32])
         .expand(INTRO_INNER_LABEL, out.as_mut())
         .expect("HKDF-SHA256 with L = 32 is inside the 255 x 32 byte output limit");
     out
