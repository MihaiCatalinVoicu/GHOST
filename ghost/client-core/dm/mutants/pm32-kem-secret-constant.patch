# PM-32 at a bump (design RG-5, §15.7): the X-Wing library's shared secret no longer depends on
# the ciphertext, on both sides, as a broken vodozemac or libcrux bump could make it. Both sides
# still agree, every open still decapsulates once, and a perturbed secret still fails to open (the
# perturbation lands after the constant), so PQ1's differential passes and **the host-library
# assertion alone would not see it**: it is refused by an oracle outside the crate (PQ5's RustCrypto
# x-wing decapsulation) and by PQ5's gate-variant client, whose all-zero secret is now the honest
# one — which is also what fails the PQ1 tests that open the gate envelopes.
# kills: pq_bump::pq1_every_intro_of_the_world_opens_through_the_host_open_intro_body_under_the_assertion
# kills: pq_bump::pq1_every_intro_open_of_the_world_decapsulates_exactly_once
# kills: pq_bump::pq1_the_host_assertion_passes_every_open_of_the_world
# kills: pq_bump::pq5_a_gate_variant_client_sealing_without_the_kem_is_refused_by_an_honest_recipient
# kills: pq_bump::pq5_every_intro_envelope_carries_an_x_wing_ciphertext_whose_secret_keys_its_inner_layer
# kills: pq_bump::pq5_every_seal_root_pq_carries_an_x_wing_ciphertext_its_root_depends_on
# kills: pq_bump::pq5_the_sender_keys_the_inner_layer_with_the_secret_its_ciphertext_carries
diff --git a/ghost/client-core/dm/src/pq.rs b/ghost/client-core/dm/src/pq.rs
index e152b0d..96a0e81 100644
--- a/ghost/client-core/dm/src/pq.rs
+++ b/ghost/client-core/dm/src/pq.rs
@@ -218,6 +218,8 @@ pub fn encapsulate_with(
     let mut shared = [0u8; SHARED_SECRET_BYTES];
     XWing::encaps(&mut ciphertext, &mut shared, public, randomness)
         .map_err(|error| encaps_code(&error))?;
+    // MUTANT (PM-32 at a bump): the KEM's secret no longer depends on the ciphertext.
+    shared = [0u8; SHARED_SECRET_BYTES];
     #[cfg(any(test, feature = "pq-spy"))]
     spy::encapsulated(&mut shared);
     let secret = KemSecret::from_bytes(shared);
@@ -256,6 +258,8 @@ fn decapsulate_expanded(seed: &KemSecret, ciphertext: &[u8]) -> DmResult<(KemSec
     let mut shared = [0u8; SHARED_SECRET_BYTES];
     XWing::decaps(&mut shared, ciphertext, &pair.decapsulation)
         .map_err(|error| decaps_code(&error))?;
+    // MUTANT (PM-32 at a bump): the KEM's secret no longer depends on the ciphertext.
+    shared = [0u8; SHARED_SECRET_BYTES];
     #[cfg(any(test, feature = "pq-spy"))]
     spy::decapsulated(&mut shared);
     let secret = KemSecret::from_bytes(shared);
