# PM-32 (design §15.7) on the recipient's side: a recipient that, when the KEM key does not open
# the inner layer, retries with a key without the X-Wing secret. Honest senders are unaffected
# (one decapsulation per open, and a perturbed secret fails both keys), so PQ1 over the honest
# envelopes and the world pass: only a sender that sealed without the KEM tells. PQ5's gate-variant
# client is accepted, and so are its envelopes in the two PQ1 tests that open them too.
# kills: pq_bump::pq5_a_gate_variant_client_sealing_without_the_kem_is_refused_by_an_honest_recipient
# kills: pq_bump::pq1_every_intro_open_of_the_world_decapsulates_exactly_once
# kills: pq_bump::pq1_the_host_assertion_passes_every_open_of_the_world
diff --git a/ghost/client-core/dm/src/seal.rs b/ghost/client-core/dm/src/seal.rs
index cbadf5b..fb52ff2 100644
--- a/ghost/client-core/dm/src/seal.rs
+++ b/ghost/client-core/dm/src/seal.rs
@@ -894,17 +894,20 @@ pub(crate) fn open_intro_layer(
     let shared = pq::decapsulate(gen_seed, &outer.ciphertext)?;
     let transcript = intro_transcript(context, &outer.ciphertext);
     let inner_ad = intro_inner_ad(&transcript);
-    let plain = Zeroizing::new(
-        aead(&intro_inner_key(&shared, &transcript))?
-            .decrypt(
-                &zero_nonce(),
-                Payload {
-                    msg: &outer.inner,
-                    aad: &inner_ad,
-                },
-            )
+    let payload = || Payload {
+        msg: &outer.inner[..],
+        aad: &inner_ad[..],
+    };
+    // MUTANT (PM-32): a lenient recipient. When the KEM key does not open the layer, it retries
+    // with an inner key without the X-Wing secret, so a sender that sealed without the KEM is
+    // accepted. Every honest envelope still opens on the first try.
+    let opened = match aead(&intro_inner_key(&shared, &transcript))?.decrypt(&zero_nonce(), payload()) {
+        Ok(plain) => plain,
+        Err(_) => aead(&intro_inner_key(&KemSecret::from_bytes([0u8; 32]), &transcript))?
+            .decrypt(&zero_nonce(), payload())
             .map_err(|_| DmCode::NotOpen)?,
-    );
+    };
+    let plain = Zeroizing::new(opened);
     parse_intro_inner(&plain)
 }
 
