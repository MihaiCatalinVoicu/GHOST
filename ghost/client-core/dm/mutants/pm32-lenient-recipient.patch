@@ -897,17 +897,20 @@ pub(crate) fn open_intro_layer(
     let shared = pq::decapsulate(gen_seed, &outer.ciphertext)?;
     let transcript = intro_transcript(context, &outer.ciphertext);
     let inner_ad = intro_inner_ad(&transcript);
-    let plain = Zeroizing::new(
-        aead(&intro_inner_key(&shared, &transcript))?
-            .decrypt(
-                &zero_nonce(),
-                Payload {
-                    msg: &outer.inner,
-                    aad: &inner_ad,
-                },
-            )
+    let payload = || Payload {
+        msg: &outer.inner[..],
+        aad: &inner_ad[..],
+    };
+    // MUTANT (PM-32): a lenient recipient. When the KEM key does not open the layer, it retries
+    // with an inner key without the X-Wing secret, so a sender that sealed without the KEM is
+    // accepted. Every honest envelope still opens on the first try.
+    let opened = match aead(&intro_inner_key(&shared, &transcript))?.decrypt(&zero_nonce(), payload()) {
+        Ok(plain) => plain,
+        Err(_) => aead(&intro_inner_key(&KemSecret::from_bytes([0u8; 32]), &transcript))?
+            .decrypt(&zero_nonce(), payload())
             .map_err(|_| DmCode::NotOpen)?,
-    );
+    };
+    let plain = Zeroizing::new(opened);
     parse_intro_inner(&plain)
