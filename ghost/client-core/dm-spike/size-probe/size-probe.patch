index 0000000..8dee399
--- /dev/null
+++ b/ghost/client-core/dm-probe/src/lib.rs
@@ -0,0 +1,140 @@
+//! Temporary S0′ size probe: exercises the vodozemac and X-Wing calls the DM crate will make, so
+//! the linker keeps what ghost-client-dm would keep, and checks how JNI exports survive linking.
+
+pub use jni;
+
+/// One Olm session both ways through a dehydrated-device account and JSON pickles.
+#[cfg(not(any(feature = "v11", feature = "v10")))]
+pub fn probe_olm(_input: &[u8]) -> Vec<u8> {
+    Vec::new()
+}
+
+#[cfg(any(feature = "v11", feature = "v10"))]
+pub fn probe_olm(input: &[u8]) -> Vec<u8> {
+    #[cfg(feature = "v11")]
+    use vz11 as vz;
+    #[cfg(all(feature = "v10", not(feature = "v11")))]
+    use vz10 as vz;
+    use vz::olm::{Account, OlmMessage, Session, SessionConfig, SessionPickle};
+
+    let mut out = Vec::new();
+    let mut b = Account::new();
+    b.generate_fallback_key();
+    let Some(fallback) = b.fallback_key().values().next().copied() else { return out };
+    let mut key = [7u8; 32];
+    if let Some(first) = input.first() {
+        key[0] = *first;
+    }
+    let Ok(exported) = b.to_dehydrated_device(&key) else { return out };
+    let Ok(mut b) = Account::from_dehydrated_device(&exported.ciphertext, &exported.nonce, &key) else { return out };
+    let a = Account::new();
+    let Ok(mut outbound) = a.create_outbound_session(SessionConfig::version_1(), b.curve25519_key(), fallback) else {
+        return out;
+    };
+    let Ok(OlmMessage::PreKey(prekey)) = outbound.encrypt(input) else { return out };
+    let Ok(created) = b.create_inbound_session(SessionConfig::version_1(), a.curve25519_key(), &prekey) else {
+        return out;
+    };
+    let Ok(json) = serde_json::to_vec(&created.session.pickle()) else { return out };
+    let Ok(parsed) = serde_json::from_slice::<SessionPickle>(&json) else { return out };
+    let mut inbound = Session::from_pickle(parsed);
+    let Ok(reply) = inbound.encrypt(&created.plaintext) else { return out };
+    let (kind, bytes) = reply.to_parts();
+    let Ok(message) = OlmMessage::from_parts(kind, &bytes) else { return out };
+    if let Ok(plaintext) = outbound.decrypt(&message) {
+        out = plaintext;
+    }
+    out
+}
+
+/// X-Wing key generation from a seed, encapsulation and decapsulation.
+#[cfg(not(any(feature = "kem", feature = "kem-trait")))]
+pub fn probe_kem(_input: &[u8]) -> Vec<u8> {
+    Vec::new()
+}
+
+/// X-Wing through the slice trait: the decapsulation key is re-expanded from the 32-byte seed.
+#[cfg(all(feature = "kem-trait", not(feature = "kem")))]
+pub fn probe_kem(input: &[u8]) -> Vec<u8> {
+    use libcrux_kem::XWing;
+    use libcrux_traits::kem::slice::Kem;
+    use rand::Rng;
+    let mut seed = [3u8; 32];
+    for (slot, byte) in seed.iter_mut().zip(input) {
+        *slot = *byte;
+    }
+    let mut ek = vec![0u8; 1216];
+    let mut dk = vec![0u8; 2432];
+    if XWing::keygen(&mut ek, &mut dk, &seed).is_err() {
+        return Vec::new();
+    }
+    let mut rand = [0u8; 64];
+    rand::rng().fill_bytes(&mut rand);
+    let mut ct = vec![0u8; 1120];
+    let mut ss = [0u8; 32];
+    if XWing::encaps(&mut ct, &mut ss, &ek, &rand).is_err() {
+        return Vec::new();
+    }
+    let mut opened = [0u8; 32];
+    match XWing::decaps(&mut opened, &ct, &dk) {
+        Ok(()) if opened == ss => ek,
+        _ => Vec::new(),
+    }
+}
+
+#[cfg(feature = "kem")]
+pub fn probe_kem(input: &[u8]) -> Vec<u8> {
+    use libcrux_kem::{key_gen_derand, Algorithm, Ct, PrivateKey, PublicKey};
+    let mut seed = [3u8; 32];
+    for (slot, byte) in seed.iter_mut().zip(input) {
+        *slot = *byte;
+    }
+    let Ok((_, public)) = key_gen_derand(Algorithm::XWingKemDraft06, &seed) else { return Vec::new() };
+    let encoded = public.encode();
+    let Ok(decoded) = PublicKey::decode(Algorithm::XWingKemDraft06, &encoded) else { return Vec::new() };
+    let Ok((ss, ct)) = decoded.encapsulate(&mut rand::rng()) else { return Vec::new() };
+    let Ok(ct) = Ct::decode(Algorithm::XWingKemDraft06, &ct.encode()) else { return Vec::new() };
+    let Ok(sk) = PrivateKey::decode(Algorithm::XWingKemDraft06, &seed) else { return Vec::new() };
+    match ct.decapsulate(&sk) {
+        Ok(opened) if opened.encode() == ss.encode() => encoded,
+        _ => Vec::new(),
+    }
+}
+
+/// A JNI export defined in this dependency crate itself (no macro in the cdylib).
+#[no_mangle]
+pub extern "system" fn Java_org_ghost_crypto_bridge_DmNative_probeDirect(
+    env: jni::JNIEnv,
+    _class: jni::objects::JClass,
+) -> jni::sys::jint {
+    let _ = env;
+    41
+}
+
+/// The export macro of design §2.3: invoked once in ghost-client-net's `jni_bridge.rs`.
+#[macro_export]
+macro_rules! export_jni {
+    () => {
+        #[no_mangle]
+        pub extern "system" fn Java_org_ghost_crypto_bridge_DmNative_probeOlm(
+            mut env: $crate::jni::JNIEnv,
+            _class: $crate::jni::objects::JClass,
+            input: $crate::jni::objects::JByteArray,
+        ) -> $crate::jni::sys::jbyteArray {
+            let bytes = env.convert_byte_array(&input).unwrap_or_default();
+            let out = $crate::probe_olm(&bytes);
+            env.byte_array_from_slice(&out).map(|a| a.into_raw()).unwrap_or(std::ptr::null_mut())
+        }
+
+        #[no_mangle]
+        pub extern "system" fn Java_org_ghost_crypto_bridge_DmNative_probeKem(
+            mut env: $crate::jni::JNIEnv,
+            _class: $crate::jni::objects::JClass,
+            input: $crate::jni::objects::JByteArray,
+        ) -> $crate::jni::sys::jbyteArray {
+            let bytes = env.convert_byte_array(&input).unwrap_or_default();
+            let out = $crate::probe_kem(&bytes);
+            env.byte_array_from_slice(&out).map(|a| a.into_raw()).unwrap_or(std::ptr::null_mut())
+        }
+    };
+}
