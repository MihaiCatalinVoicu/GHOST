+# Temporary S0′ size probe (V-9, V-5, V-6, V-8): linked into ghost-client-net only while the
+# patch dm-spike/size-probe/size-probe.patch is applied. Never committed to the workspace.
+[package]
+publish = false
+name = "ghost-dm-probe"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+rust-version.workspace = true
+
+[features]
+default = []
+v11 = ["dep:vz11", "dep:serde_json"]
+v10 = ["dep:vz10", "dep:serde_json"]
+kem = ["dep:libcrux-kem", "dep:rand"]
+# X-Wing through libcrux-kem's XWing slice trait only (no enum dispatch over every KEM).
+kem-trait = ["dep:libcrux-kem", "dep:libcrux-traits", "dep:rand"]
+# vodozemac's precomputed curve25519-dalek tables (G-R2: optional per the size check).
+tables = ["vz11?/precomputed-tables"]
+
+[dependencies]
+jni = { workspace = true }
+vz11 = { package = "vodozemac", version = "=0.11.0", default-features = false, optional = true }
+vz10 = { package = "vodozemac", version = "=0.10.0", default-features = false, optional = true }
+libcrux-kem = { version = "=0.0.9", default-features = false, optional = true }
+libcrux-traits = { version = "=0.0.8", default-features = false, optional = true }
+serde_json = { workspace = true, optional = true }
+rand = { workspace = true, optional = true }
diff --git a/ghost/client-core/dm-probe/src/lib.rs b/ghost/client-core/dm-probe/src/lib.rs
