+++ b/ghost/client-core/mls-probe/src/lib.rs
@@ -0,0 +1,76 @@
+//! Temporary Phase 10 S0 size probe: compiles the spike's GhostKv, provider, extensions and channel
+//! harness and runs one small channel through every operation ghost-client-mls will call, so the
+//! linker keeps what the real crate would keep. Evidence tooling, not product code.
+
+pub use jni;
+
+#[cfg(feature = "mls")]
+#[path = "../../mls-spike/core/src/codec.rs"]
+pub mod codec;
+#[cfg(feature = "mls")]
+#[path = "../../mls-spike/core/src/ext.rs"]
+pub mod ext;
+#[cfg(feature = "mls")]
+#[path = "../../mls-spike/core/src/harness.rs"]
+pub mod harness;
+#[cfg(feature = "mls")]
+#[path = "../../mls-spike/core/src/kv.rs"]
+pub mod kv;
+#[cfg(feature = "mls")]
+#[path = "../../mls-spike/core/src/provider.rs"]
+pub mod provider;
+#[cfg(feature = "mls")]
+#[path = "../../mls-spike/core/src/seal.rs"]
+pub mod seal;
+
+/// Create, admit two joiners, post, self-update, remove, add, export, sweep: returns the owner's
+/// epoch authenticator (empty on any failure).
+#[cfg(feature = "mls")]
+pub fn probe_mls(input: &[u8]) -> Vec<u8> {
+    use harness::*;
+    let _ = rayon::ThreadPoolBuilder::new().num_threads(1).build_global();
+    let day = host_day();
+    let mut w = World::build(3, 2, day);
+    let ch = w.channel;
+    let Ok(m) = w.members[1].encrypt(ch, 1, input) else { return Vec::new() };
+    if w.members[0].receive(ch, &m).is_err() || w.members[2].receive(ch, &m).is_err() {
+        return Vec::new();
+    }
+    if w.self_update(2).is_err() {
+        return Vec::new();
+    }
+    let leaf = w.members[1].leaf_index(ch);
+    if w.remove(0, leaf).is_err() || w.add_one(0).is_err() {
+        return Vec::new();
+    }
+    let _ = w.members[0].export(ch, "ghost/v1/ch/epoch");
+    if w.members[0].sweep_past(ch, 1).is_err() {
+        return Vec::new();
+    }
+    #[cfg(feature = "pq")]
+    {
+        let _ = openmls::prelude::Ciphersuite::MLS_256_XWING_CHACHA20POLY1305_SHA256_Ed25519;
+    }
+    w.members[0].authenticator(ch)
+}
+
+#[cfg(not(feature = "mls"))]
+pub fn probe_mls(_input: &[u8]) -> Vec<u8> {
+    Vec::new()
+}
+
+#[macro_export]
+macro_rules! export_jni {
+    () => {
+        #[no_mangle]
+        pub extern "system" fn Java_org_ghost_crypto_bridge_MlsNative_probeMls(
+            mut env: $crate::jni::JNIEnv,
+            _class: $crate::jni::objects::JClass,
+            input: $crate::jni::objects::JByteArray,
+        ) -> $crate::jni::sys::jbyteArray {
+            let bytes = env.convert_byte_array(&input).unwrap_or_default();
+            let out = $crate::probe_mls(&bytes);
+            env.byte_array_from_slice(&out).map(|a| a.into_raw()).unwrap_or(std::ptr::null_mut())
+        }
+    };
+}
