+# TEMPORARY V10-1 probe: an empty stand-in for openmls's optional openmls_sqlite_storage 0.3.0, so
+# the ghost lock resolves (its rusqlite 0.37 -> libsqlite3-sys 0.35 conflicts with Arti's 0.37 on
+# links = "sqlite3"). The sqlite-provider feature is forbidden (design §3.2), so nothing uses it.
+[package]
+name = "openmls_sqlite_storage"
+version = "0.3.0"
+edition = "2021"
+publish = false
+license = "MIT"
+
+[features]
+draft-ietf-mls-pq-ciphersuites = []
+extensions-draft = []
+virtual-clients-draft = []
+test-utils = []
+
+[lib]
+path = "src/lib.rs"
