+# TEMPORARY Phase 10 S0 size probe (V10-1, V10-3, V10-7): linked into ghost-client-net only while
+# client-core/mls-spike/size-probe/size-probe.patch is applied. Never committed to the workspace.
+# It compiles the spike's adapter, provider, extensions and channel harness (by #[path]) so the
+# linker keeps what ghost-client-mls would keep.
+[package]
+publish = false
+name = "ghost-mls-probe"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+rust-version.workspace = true
+
+[features]
+default = []
+# The OpenMLS stack (off: the probe links only its JNI export).
+mls = ["dep:openmls", "dep:openmls_traits", "dep:openmls_libcrux_crypto", "dep:ed25519-dalek", "dep:serde", "dep:serde_json", "dep:chacha20poly1305", "dep:sha2", "dep:rayon", "dep:tls_codec"]
+# Q2 evidence only: OpenMLS's X-Wing suites (forbidden in shipped graphs, design §3.2).
+pq = ["mls", "openmls/draft-ietf-mls-pq-ciphersuites", "openmls_traits/draft-ietf-mls-pq-ciphersuites", "openmls_libcrux_crypto/draft-ietf-mls-pq-ciphersuites"]
+
+[dependencies]
+jni = { workspace = true }
+openmls = { version = "=0.9.0", default-features = false, optional = true }
+openmls_traits = { version = "=0.6.0", default-features = false, optional = true }
+openmls_libcrux_crypto = { version = "=0.4.0", default-features = false, optional = true }
+ed25519-dalek = { workspace = true, optional = true }
+serde = { workspace = true, optional = true }
+serde_json = { workspace = true, optional = true }
+chacha20poly1305 = { version = "=0.11.0", default-features = false, features = ["alloc"], optional = true }
+sha2 = { workspace = true, optional = true }
+rayon = { version = "=1.12.0", optional = true }
+tls_codec = { version = "=0.5.0", features = ["derive", "serde", "mls"], optional = true }
diff --git a/ghost/client-core/mls-probe/src/lib.rs b/ghost/client-core/mls-probe/src/lib.rs
