# GHOST Phase 12 — lyrebird pins (S0 draft for the lead; see docs/design/faza12-s0-evidence.md)
# The real pin is the commit hash; the tag is documentation.
LYREBIRD_TAG=0.9.0
LYREBIRD_COMMIT=89d54872b176f936232ff39f7a8189b77d83d65e
LYREBIRD_SOURCE_ARCHIVE_SHA256=d5c8fd4dbcf190b13ec9d20aa0ac7d6df0bc271c7911712250f10438d9b7bec0
# go.dev release JSON-verified (https://go.dev/dl/?mode=json&include=all).
GO_VERSION=1.26.0
GO_TARBALL=go1.26.0.windows-amd64.zip
GO_TARBALL_SHA256=9bbe0fc64236b2b51f6255c05c4232532b8ecc0e6d2e00950bd3021d8a4d07d4
# Same NDK build-native.sh pins (its llvm-strip + clang live here).
NDK_VERSION=30.0.16248370
NDK_CLANG_ABI29_X86_64=toolchains/llvm/prebuilt/windows-x86_64/bin/x86_64-linux-android29-clang.cmd
# Required by Go 1.26 for the unpruned tree (legacy go:linkname in wlynxg/anet,
# then pulled by snowflake). The pruned tree no longer contains anet; the flag is
# kept because it is harmless there and future pins may re-introduce the dep.
GO_EXTRA_LDFLAGS=-checklinkname=0
# The pinned minimal prune patch (rev 2, OA-3 applied): applied to the source
# right after checkout; the binary then carries exactly obfs4 + webtunnel.
# Deletions + `go mod tidy` only (diffstat in the evidence doc §10.1); verified
# with `git apply --check` against the pinned commit.
PRUNE_PATCH=prune-snowflake.patch
PRUNE_PATCH_SHA256=51a5cc692594a11cbb2e8adb45a8eb279629c2a0445dd54398cf93abb55d6897
# Version stamp: upstream's Makefile derives it from `git describe` (not
# reproducible); pin it to the tag.
LYREBIRD_VERSION_STAMP=0.9.0
# Size budgets (rev 2, OA-3 applied; design §9.1 — G-T3 enforces these exact values against
# out/lyrebird-android-*; a bump that grows the binary re-pins them here, with the evidence).
LYREBIRD_ARM64_SIZE_MAX=7668008
LYREBIRD_AMD64_SIZE_MAX=7556392
LYREBIRD_ARM64_GZIP_MAX=2899241
LYREBIRD_AMD64_GZIP_MAX=3107257
