(* GHOST direct messages: harvest-now-decrypt-later secrecy of the intro inner layer (obligation
   M-1) and PQ-B, the PQ-only transport of seal keys (obligation M-3), design faza9-dm.md §6.4,
   §6.7, §6.3, §9.3, §9.5; slice S13.

   The one-scan flow of §12.2 / §21.3 point 1, as a future quantum adversary holding the relay
   archive sees it:
     1. A's first flight: an intro envelope. The outer layer is keyed by B's card (KIO_B), which a
        card holder has, so the adversary here holds KIO_B (M-1's "the adversary knows KIO"). The
        inner layer is keyed by k_in = HKDF(ss, T_in), ss from an X-Wing encapsulation to B's
        bundle generation, and carries A's card, reply_seed and the first L1.
     2. B's reply: a provisional envelope under K_prov = HKDF(reply_seed, sb, dir), carrying B's
        root (seal_root) in its Olm content.
     3. A's next message: a pair envelope under B's root, carrying A's root.
   X25519 is broken (quantum), so every Olm layer is transparent — an L0 is as good as its
   envelope — and the session binding sb (built from Olm public keys) is public. X-Wing is then as
   strong as ML-KEM-768: an ideal IND-CCA KEM. The adversary is passive (HNDL): reliable delivery
   on net, every message copied to c.

   PQ-B's induction is visible in the chain: reply_seed is secret only through k_in (KEM), B's root
   only through K_prov (reply_seed), A's root and the pair content only through B's root. Expected
   results are in expected.txt; outerOnly is the control that the adversary does hold KIO_B. *)

free c: channel.
free net: channel [private].

type key.
type kskey.
type kpkey.

fun kpk(kskey): kpkey.
fun kct(kpkey, bitstring): bitstring.
fun kss(kpkey, bitstring): bitstring.
reduc forall sk: kskey, r: bitstring; kdec(sk, kct(kpk(sk), r)) = kss(kpk(sk), r).

(* k_in = HKDF(ss, salt = T_in, "ghost/v1/dm-intro-inner") *)
fun kin(bitstring, bitstring): key.
(* K_prov(dir) = HKDF(reply_seed, salt = sb, "ghost/v1/dm/prov" || dir) *)
fun kprov(bitstring, bitstring, bitstring): key.
(* K_b of a root (§6.3) *)
fun kroot(bitstring): key.

fun seal(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; unseal(seal(m, k), k) = m.

(* B's card intro key: every holder of B's card has it. *)
free kioB: key.
free ns: bitstring.
free oiA: bitstring.
free oiB: bitstring.
free gen0: bitstring.
free dirToInitiator: bitstring.
free dirToResponder: bitstring.

free cardA: bitstring [private].
free replySeed: bitstring [private].
free l1First: bitstring [private].
free rootB: bitstring [private].
free msgProvisional: bitstring [private].
free rootA: bitstring [private].
free msgPair: bitstring [private].
(* Control: a value sealed under the card-keyed outer layer alone. *)
free outerOnly: bitstring [private].

query attacker(cardA).
query attacker(replySeed).
query attacker(l1First).
query attacker(rootB).
query attacker(msgProvisional).
query attacker(rootA).
query attacker(msgPair).
query attacker(outerOnly).

let Initiator(pkG: kpkey) =
  new r: bitstring;
  new baseKey: bitstring;
  let ct = kct(pkG, r) in
  let tin = (ns, gen0, pkG, ct, oiB) in
  let inner = seal((cardA, replySeed, l1First), kin(kss(pkG, r), tin)) in
  let outer = seal((gen0, ct, inner), kioB) in
  out(c, (baseKey, outer));
  out(net, (baseKey, outer));
  (* B's provisional reply, opened with the reply_seed A generated *)
  in(net, prov: bitstring);
  let (rB: bitstring, mB: bitstring) = unseal(prov, kprov(replySeed, (oiA, baseKey, oiB), dirToInitiator)) in
  let pair = seal((rootA, msgPair), kroot(rB)) in
  out(c, pair);
  out(net, pair).

let Responder(skG: kskey) =
  in(net, (baseKey: bitstring, outer: bitstring));
  let (=gen0, ct: bitstring, inner: bitstring) = unseal(outer, kioB) in
  let tin = (ns, gen0, kpk(skG), ct, oiB) in
  let (card: bitstring, seed: bitstring, l1: bitstring) = unseal(inner, kin(kdec(skG, ct), tin)) in
  let prov = seal((rootB, msgProvisional), kprov(seed, (oiA, baseKey, oiB), dirToInitiator)) in
  out(c, prov);
  out(net, prov);
  (* A's pair envelope under B's root *)
  in(net, pair: bitstring);
  let (rA: bitstring, m: bitstring) = unseal(pair, kroot(rootB)) in
  0.

process
  new skG: kskey;
  (
    out(c, kpk(skG))
  | out(c, seal(outerOnly, kioB))
  | Initiator(kpk(skG))
  | Responder(skG)
  )
