(* GHOST direct messages: PQ-C healing (design faza9-dm.md §9.4 "Healing argument";
   obligation M-6 of §9.5; slice S13).

   The claim: a passive adversary reads both devices' complete state at time t, records all relay
   traffic afterwards, owns a quantum computer, and compromises nothing more. Once a root offered
   after t is a seal_root_pq encapsulated to a generation created after t, the envelopes sealed
   under it are secret; everything sealed under a root the leak contained, a classical root, or a
   PQ-C root to a leaked generation is not.

   Modelling choices, each one a statement of the adversary:
   - "Owns a quantum computer" is X25519 broken and ML-KEM-768 intact. X-Wing is then as strong
     as its ML-KEM half, so it is an ideal IND-CCA KEM here (kct/kss/kdec); every classical layer
     is transparent: Olm content, and so every TLV an L0 carries (root_rand, ct, a classical root,
     a pq_key), is output on the public channel c.
   - "Passive" is reliable delivery on the private channel net: every protocol message is also
     copied to c, so the adversary sees all of it, but a receiver only accepts what a peer sent.
     An active adversary after t is out of scope of §9.4, and would win trivially by encapsulating
     to the announced key itself.
   - "Both devices' state at t" is phase 1's first outputs: the generation secret live at t and
     the root of the direction live at t. The generation created after t is never output.
   - A root keys weeks through kbase and the one-way ratchet knext (§6.3); the pair seal is an
     ideal AEAD.

   The four messages are one direction (A -> B, keyed by roots B offers and A opens), each sealed
   after t under a different kind of root. Expected results are in expected.txt. *)

free c: channel.
free net: channel [private].

type key.
type kskey.
type kpkey.

(* X-Wing with its X25519 half broken: an ideal KEM. *)
fun kpk(kskey): kpkey.
fun kct(kpkey, bitstring): bitstring.
fun kss(kpkey, bitstring): bitstring.
reduc forall sk: kskey, r: bitstring; kdec(sk, kct(kpk(sk), r)) = kss(kpk(sk), r).

(* root = HKDF(root_rand || ss, salt = SHA-256(label || OI_offerer || OI_target || gen || Q || ct)) *)
fun pqroot(bitstring, bitstring, bitstring): key.
(* a classical seal_root: the 32 bytes are the root *)
fun classicalroot(bitstring): key.
(* K_b = HKDF(root, "pair-epoch" || b) and K_{w+1} = HKDF(K_w, "pair-next") *)
fun kbase(key): key.
fun knext(key): key.

(* the pair seal *)
fun seal(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; unseal(seal(m, k), k) = m.

free oiA: bitstring.
free oiB: bitstring.
free genOld: bitstring.
free genNew: bitstring.
free tagClassical: bitstring.
free tagPqOld: bitstring.
free tagPqNew: bitstring.

(* Sealed after t under the root live at t, a week after the leak. *)
free msgBefore: bitstring [private].
(* Sealed after t under a classical root offered after t. *)
free msgClassical: bitstring [private].
(* Sealed after t under a PQ-C root encapsulated to the generation the leak contained. *)
free msgPqOld: bitstring [private].
(* Sealed after t under a PQ-C root encapsulated to a generation created after t: healed. *)
free msgHealed: bitstring [private].
(* The same healed root a week later: the ratchet does not reopen what the root closed. *)
free msgHealedLater: bitstring [private].

query attacker(msgHealed).
query attacker(msgHealedLater).
query attacker(msgBefore).
query attacker(msgClassical).
query attacker(msgPqOld).

(* B, the recipient of direction A -> B, offers a root: classical, or PQ-C to A's key pk. *)
let OfferClassical(tag: bitstring) =
  new rootBytes: bitstring;
  out(c, (tag, rootBytes));
  out(net, (tag, rootBytes)).

let OfferPq(tag: bitstring, gen: bitstring, pk: kpkey) =
  new rootRand: bitstring;
  new r: bitstring;
  let ct = kct(pk, r) in
  out(c, (tag, rootRand, gen, ct));
  out(net, (tag, rootRand, gen, ct)).

(* A, the sender, installs the root as its out key and seals under it. *)
let SealClassical(tag: bitstring, msg: bitstring) =
  in(net, (=tag, rootBytes: bitstring));
  out(c, seal(msg, kbase(classicalroot(rootBytes)))).

let SealPq(tag: bitstring, sk: kskey, gen: bitstring, msg: bitstring, later: bitstring) =
  in(net, (=tag, rootRand: bitstring, =gen, ct: bitstring));
  let ss = kdec(sk, ct) in
  let root = pqroot(rootRand, ss, (oiB, oiA, gen, kpk(sk), ct)) in
  out(c, seal(msg, kbase(root)));
  out(c, seal(later, knext(kbase(root)))).

process
  new skOld: kskey;
  new skNew: kskey;
  new rootAtT: bitstring;
  (
    (* Before t: A's generation live at t is published (bundle, pq_key). *)
    out(c, kpk(skOld))
  | (* t: both devices' state leaks. *)
    phase 1; out(c, skOld); out(c, rootAtT)
  | (* After t: A's new generation is announced in band; its secret stays on A. *)
    phase 1; out(c, kpk(skNew))
  | phase 1; out(c, seal(msgBefore, knext(kbase(classicalroot(rootAtT)))))
  | phase 1; OfferClassical(tagClassical)
  | phase 1; SealClassical(tagClassical, msgClassical)
  | phase 1; OfferPq(tagPqOld, genOld, kpk(skOld))
  | phase 1; SealPq(tagPqOld, skOld, genOld, msgPqOld, msgPqOld)
  | phase 1; OfferPq(tagPqNew, genNew, kpk(skNew))
  | phase 1; SealPq(tagPqNew, skNew, genNew, msgHealed, msgHealedLater)
  )
