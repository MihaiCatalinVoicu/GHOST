(* GHOST direct messages: binding v3 (design faza9-dm.md §3.4, §6.4, §6.5 step 4; obligation
   M-2 of §9.5; slice S13).

   Binding v3 is the sender's Ed25519 signature over (label, OI_A, base key, X-Wing ciphertext,
   namespace, binding minute, OI_B), carried in the intro inner layer. M-2 asks for:
   - agreement: a recipient that accepts a binding under the pinned identity of A accepts exactly
     the (OI_A, base key, ct, namespace, minute, OI_B) that A signed;
   - key-compromise impersonation with the recipient's full state: the recipient's own secrets
     (its Ed25519 key and its generation secret) do not let the adversary produce an accepted
     binding in A's name;
   - no transfer across envelopes: the ciphertext, the namespace and the recipient's identity are
     in the signed statement, so a binding lifted onto another envelope or into another inbox does
     not verify.

   Two recipients, B and D, each with its own inbox namespace, Olm identity and generation, and
   A binds intros to both (the slice S13 review: with one recipient the namespace and OI_B were
   constants on both sides of the query, and removing them from the signed statement changed no
   result). A recipient accepts a binding only for its own namespace and identity; a binding A
   made for B, presented to D, is a transfer, and the agreement query catches it. The mutant
   m2_binding_mutant_unbound_recipient.pv (generated by its .patch) signs neither the namespace
   nor OI_B, and its agreement query must fail.

   Authentication is classical (PQ-R1): the adversary here is the classical Dolev-Yao attacker,
   active on c, and signatures are ideal. Freshness of the binding minute is RECV's R5 (§21.4) and
   replays are D2b's (§7.6), so the property is non-injective agreement. The control is a third
   identity C whose signing key leaks: its bindings are forgeable, and the same query on C fails.
   AcceptedHonest is reachable only through a binding A really made (A's key never leaks), so the
   reachability query, expected `false`, shows an honest binding does verify — without it a
   Sender/Receiver format mismatch would make the agreement query vacuously `true`. *)

free c: channel.

type skey.
type spkey.
type kskey.
type kpkey.

fun spk(skey): spkey.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; checksign(sign(m, k), spk(k)) = m.
reduc forall m: bitstring, k: skey; getmess(sign(m, k)) = m.

fun kpk(kskey): kpkey.
fun kct(kpkey, bitstring): bitstring.
fun kss(kpkey, bitstring): bitstring.
reduc forall sk: kskey, r: bitstring; kdec(sk, kct(kpk(sk), r)) = kss(kpk(sk), r).

free labelBinding: bitstring.
free nsB: bitstring.
free nsD: bitstring.
free oiA: bitstring.
free oiB: bitstring.
free oiC: bitstring.
free oiD: bitstring.

event Bound(spkey, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event Accepted(spkey, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event AcceptedFromC(spkey, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event AcceptedHonest.

(* M-2: agreement on every field, with both recipients' whole state public. *)
query k: spkey, x1: bitstring, x2: bitstring, x3: bitstring, x4: bitstring, x5: bitstring, x6: bitstring;
  event(Accepted(k, x1, x2, x3, x4, x5, x6)) ==> event(Bound(k, x1, x2, x3, x4, x5, x6)).

(* Control: the same agreement for an identity whose signing key leaked. *)
query k: spkey, x1: bitstring, x2: bitstring, x3: bitstring, x4: bitstring, x5: bitstring, x6: bitstring;
  event(AcceptedFromC(k, x1, x2, x3, x4, x5, x6)) ==> event(Bound(k, x1, x2, x3, x4, x5, x6)).

(* Reachability: an honest binding of A's is accepted. *)
query event(AcceptedHonest).

(* A sender: a fresh base key, a fresh encapsulation to the recipient's generation, a fresh
   minute, and the recipient's namespace and identity in the signed statement. *)
let Sender(sk: skey, oiSender: bitstring, pkG: kpkey, nsR: bitstring, oiR: bitstring) =
  new baseKey: bitstring;
  new r: bitstring;
  new minute: bitstring;
  let ct = kct(pkG, r) in
  event Bound(spk(sk), oiSender, baseKey, ct, nsR, minute, oiR);
  out(c, (oiSender, baseKey, ct, minute,
          sign((labelBinding, oiSender, baseKey, ct, nsR, minute, oiR), sk))).

(* A recipient with inbox namespace nsR and Olm identity oiR, checking a binding under the pinned
   identity of the claimed sender (§6.5 step 4). The namespace is the one the blob was deposited
   in, which the recipient knows; the binding must name it and the recipient. *)
let Receiver(pinned: spkey, nsR: bitstring, oiR: bitstring) =
  in(c, (oiSender: bitstring, baseKey: bitstring, ct: bitstring, minute: bitstring, s: bitstring));
  let (=labelBinding, =oiSender, =baseKey, =ct, =nsR, =minute, =oiR) = checksign(s, pinned) in
  event Accepted(pinned, oiSender, baseKey, ct, nsR, minute, oiR);
  event AcceptedHonest.

let ReceiverFromC(pinned: spkey, nsR: bitstring, oiR: bitstring) =
  in(c, (oiSender: bitstring, baseKey: bitstring, ct: bitstring, minute: bitstring, s: bitstring));
  let (=labelBinding, =oiSender, =baseKey, =ct, =nsR, =minute, =oiR) = checksign(s, pinned) in
  event AcceptedFromC(pinned, oiSender, baseKey, ct, nsR, minute, oiR).

process
  new skA: skey;
  new skB: skey;
  new skC: skey;
  new skD: skey;
  new skGB: kskey;
  new skGD: kskey;
  (
    out(c, spk(skA)); out(c, spk(skB)); out(c, spk(skC)); out(c, spk(skD));
    out(c, kpk(skGB)); out(c, kpk(skGD))
  | (* both recipients' full state: identity keys and generation secrets (KCI) *)
    out(c, skB); out(c, skGB); out(c, skD); out(c, skGD)
  | (* the control identity's key leaks *)
    out(c, skC)
  | !Sender(skA, oiA, kpk(skGB), nsB, oiB)
  | !Sender(skA, oiA, kpk(skGD), nsD, oiD)
  | !Sender(skC, oiC, kpk(skGB), nsB, oiB)
  | !Receiver(spk(skA), nsB, oiB)
  | !Receiver(spk(skA), nsD, oiD)
  | !ReceiverFromC(spk(skC), nsB, oiB)
  )
