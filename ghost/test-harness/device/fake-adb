#!/usr/bin/env bash
# A fake `adb` for the self-test of scripts/device/dm-gate.sh (Phase 9 design §15.10; slice S12). It
# answers as two gate phones — serials A and B — sharing one conversation that is delivered
# instantly, and speaks the protocol the orchestrator uses: `am instrument -w -e cmd …` with
# `INSTRUMENTATION_RESULT: key=value` lines and `INSTRUMENTATION_CODE: -1`, plus the shell commands
# around it (airplane mode, kills, reboots, screen off and on, run-as export).
#
# Its digests are its own (SHA-256 over its text ids): the orchestrator only compares the two
# phones' digests with each other, so equality is what the fake has to get right. What the real
# phones compute is `OrderDigests`, pinned by the JVM test `OrderDigestsTest`.
#
# Timed messages expire as the real ones would by the time the orchestrator looks: a 5-minute one
# (timer code 1) at the first session after a screen was turned off, which is how step 6 waits, and
# a 1-hour one (code 2) at the first session after the re-store of step 4, which on real phones
# runs hours later. `send` with a `tag` keeps the tag for the `leak-tag` lie.
#
# FAKE_ADB_DIR holds the state; FAKE_ADB_BUG makes one phone lie the way a defect would:
#   reorder         B renders the conversation in another order
#   duplicate       B renders one message twice
#   safety          B's safety number digest differs
#   nochange        A never shows the key change
#   leak            the phones' card is also printed as an extra result key (the orchestrator must not log it)
#   unverified      B shows A as UNVERIFIED after a QR add
#   stale-identity  B's key change answers ALREADY_ACTIVE (the new identity over the old one's rows)
#   nohigh          A's sessions run in STANDARD mode whatever they were asked for
#   noexpiry        timed messages never expire
#   leak-tag        the exported database carries the message tag in the clear
#   replayed        B shows the re-stored blobs as new messages
# Nothing here is a phone: it is the orchestrator's counterpart for its own self-test.
set -euo pipefail
dir="${FAKE_ADB_DIR:?}"
bug="${FAKE_ADB_BUG:-}"
[ "${1:-}" = "-s" ] || { echo "fake-adb: expected -s <serial>" >&2; exit 2; }
serial="$2"
shift 2
mkdir -p "$dir"
touch "$dir/conversation" "$dir/changed" "$dir/b-extra" "$dir/events"

sha() { sha256sum | cut -d' ' -f1; }
card() { printf 'c0%062d' "$(printf '%s' "$1" | od -An -tu1 | tr -d ' \n' | cut -c1-6)"; }
ok() { printf 'INSTRUMENTATION_RESULT: %s\n' "$@"; printf 'INSTRUMENTATION_CODE: -1\n'; }
event() { printf '%s %s\n' "$serial" "$*" >> "$dir/events"; }

case "${1:-}" in
  install) echo "Success"; exit 0 ;;
  reboot) event reboot; exit 0 ;;
  wait-for-device) exit 0 ;;
  exec-out)
    # exec-out run-as <pkg> cat databases/<file>
    printf 'SQLite format 3\0encrypted pages'
    if [ "$bug" = leak-tag ] && [ -s "$dir/tag" ]; then printf 'gate %s 1' "$(cat "$dir/tag")"; fi
    exit 0 ;;
  shell) shift ;;
  *) echo "fake-adb: unsupported $*" >&2; exit 2 ;;
esac

case "${1:-} ${2:-}" in
  "getprop sys.boot_completed") echo 1; exit 0 ;;
  "am kill"|"am force-stop") event "am $2"; exit 0 ;;
  "input keyevent")
    [ "${3:-}" = KEYCODE_SLEEP ] && touch "$dir/slept"
    exit 0 ;;
  "am instrument") ;;
  *) exit 0 ;;
esac
shift 3 # am instrument -w
declare -A arg=()
while [ $# -gt 1 ] && [ "$1" = -e ]; do arg["$2"]="$3"; shift 3; done
cmd="${arg[cmd]:-}"

digest_of() { # serial
  local ids
  ids="$(sed 's/^t[12]://' "$dir/conversation")"
  if [ "$1" = B ] && [ -s "$dir/b-extra" ]; then ids="$ids"$'\n'"$(cat "$dir/b-extra")"; ids="$(sed '/^$/d' <<<"$ids")"; fi
  if [ "$1" = B ] && [ "$bug" = reorder ]; then ids="$(tac <<<"$ids")"; fi
  if [ "$1" = B ] && [ "$bug" = duplicate ] && [ -n "$ids" ]; then ids="$ids"$'\n'"$(head -n 1 <<<"$ids")"; fi
  local count dups
  count="$(grep -c . <<<"$ids" || true)"
  dups=$(( count - $(sort -u <<<"$ids" | grep -c . || true) ))
  printf 'order=%s\nmultiset=%s\ncount=%s\nduplicates=%s\n' \
    "$(printf '%s' "$ids" | sha)" "$(sort <<<"$ids" | tr -d '\n' | sha)" "$count" "$dups"
}

timed() { local code; code="$(cat "$dir/timer-$serial" 2>/dev/null || echo 4)"; [ "$code" = 1 ] || [ "$code" = 2 ]; }
newid() { od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; }

case "$cmd" in
  card)
    if [ "$bug" = leak ]; then ok "card=$(card "$serial")" "cardcopy=$(card "$serial")"; else ok "card=$(card "$serial")"; fi ;;
  add-contact) ok "result=ADDED" "contact=$(printf '%s' "contact-$serial" | sha | cut -c1-32)" ;;
  send)
    n="${arg[count]}"
    if [ "$serial" = A ] && [ -s "$dir/changed" ]; then ok "send.KEY_CHANGED=$n"; exit 0; fi
    [ -n "${arg[tag]:-}" ] && printf '%s' "${arg[tag]}" > "$dir/tag"
    for _ in $(seq "$n"); do
      if [ "$serial" = B ] && [ -f "$dir/keychanged" ] && [ "$bug" != nochange ]; then
        echo 1 > "$dir/changed"; echo "held-$RANDOM$RANDOM" >> "$dir/held"
      elif timed; then
        printf 't%s:%s\n' "$(cat "$dir/timer-$serial")" "$(newid)" >> "$dir/conversation"
      else
        printf '%s\n' "$(newid)" >> "$dir/conversation"
      fi
    done
    ok "send.QUEUED=$n" ;;
  digest) mapfile -t lines < <(digest_of "$serial"); ok "${lines[@]}" ;;
  safety)
    if [ "$serial" = B ] && [ "$bug" = safety ]; then ok "safety=$(echo other | sha)"; else ok "safety=$(echo same | sha)"; fi ;;
  contacts)
    c="$(printf '%s' "contact-$serial" | sha | cut -c1-32)"
    if [ "$serial" = A ] && [ -s "$dir/changed" ]; then ok "contacts=$c:CHANGED:READY"
    elif [ "$serial" = B ] && [ "$bug" = unverified ]; then ok "contacts=$c:UNVERIFIED:READY"
    else ok "contacts=$c:VERIFIED:READY"; fi ;;
  key-change)
    touch "$dir/keychanged"
    if [ "$bug" = stale-identity ]; then ok "result=ALREADY_ACTIVE"; else ok "result=ACTIVATED"; fi ;;
  ack-key-change)
    : > "$dir/changed"
    rm -f "$dir/keychanged"
    if [ -f "$dir/held" ]; then cat "$dir/held" >> "$dir/conversation"; rm -f "$dir/held"; fi
    ok "result=true" ;;
  pass)
    event "pass ${arg[privacy]:-STANDARD}"
    if [ -f "$dir/slept" ] && [ "$bug" != noexpiry ]; then sed -i '/^t1:/d' "$dir/conversation"; rm -f "$dir/slept"; fi
    if [ -f "$dir/restored" ]; then sed -i '/^t2:/d' "$dir/conversation"; fi
    if [ "$serial" = B ] && [ "$bug" = replayed ] && [ -f "$dir/restored" ] && [ ! -s "$dir/b-extra" ]; then
      for i in 1 2 3 4 5; do echo "replayed-$i" >> "$dir/b-extra"; done
    fi
    mode="${arg[privacy]:-STANDARD}"
    if [ "$serial" = A ] && [ "$bug" = nohigh ]; then mode=STANDARD; fi
    ok "result=PASSED" "privacy=$mode" "drop.DUPLICATE=0" ;;
  status) ok "poisoned=0" "drop.DUPLICATE=0" ;;
  timer)
    echo "${arg[code]}" > "$dir/timer-$serial"
    printf 'timer-%s\n' "$(newid)" >> "$dir/conversation"
    ok "result=QUEUED" ;;
  export-deposits)
    ttl=604800; timed && ttl=3600
    set -- "namespace=$(printf ns | sha)" "credential=$(printf credential | sha)" "onion=fakeonionaddress.onion:443" "ttl=$ttl"
    for i in 0 1 2 3 4; do set -- "$@" "blob.$i=$(printf 'blob%s' "$i" | sha)"; done
    ok "$@" ;;
  *) printf 'INSTRUMENTATION_RESULT: error=bad-argument\nINSTRUMENTATION_CODE: 0\n' ;;
esac
