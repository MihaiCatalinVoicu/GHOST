#!/usr/bin/env bash
# Fixture symbol reader for G-R6 (`scripts/gates/dm-jni-surface.sh`): a test library as §22.37 built
# it — the closed list, `DmEquivalence.run` and `DmEquivalence.bindingHooks`, without
# `DmEquivalence.stateWrapHook` (§22.38) — nor `.sidecarLogHook`, which came after it. Refused with
# `--test`: the crash worlds' ME-24 would find no switch in it.
set -euo pipefail
"$(dirname "$0")/exact-nm" "$@"
printf '%016x T Java_org_ghost_crypto_bridge_DmEquivalence_run\n' 65536
printf '%016x T Java_org_ghost_crypto_bridge_DmEquivalence_bindingHooks\n' 65600
