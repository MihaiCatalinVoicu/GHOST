<?xml version="1.0" encoding="utf-8"?>
<!-- The device smoke's manifest (Phase 11 slice S5): the isolated decoding service the sandbox
     binds. The library's androidTest APK is self-instrumenting (the DeviceWorld precedent,
     Phase 9 design §15.9), so the service is declared here, exactly as the app manifest declares
     it for production. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config">

        <service
            android:name="org.ghost.media.sandbox.MediaDecodeService"
            android:isolatedProcess="true"
            android:process=":mdec"
            android:exported="false" />

        <!-- Slice S7's playback window (§10.3's FLAG_SECURE row; the snapshot scan's activity):
             the device playback test renders into it. Test-APK-local, never exported. -->
        <activity
            android:name="org.ghost.messaging.media.MediaPlaybackDeviceTest$MediaPlaybackActivity"
            android:exported="false" />
    </application>

</manifest>
