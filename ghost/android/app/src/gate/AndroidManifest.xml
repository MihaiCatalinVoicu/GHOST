<?xml version="1.0" encoding="utf-8"?>
<!-- The gate variant only (Phase 9 design 15.10, 21.13 points 4 and 7, ADR-34; slice S12): the
     instrumentation scripts/device/dm-gate.sh drives. The application is the release's own
     org.ghost.app.GhostApp; the debug key-change hook reaches it through this source set's
     DmBranch, not through a subclass (S12 review). Never in a release manifest (gate G-DM5 reads
     the release source sets; T15m reads the merged release manifest). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <instrumentation
        android:name="org.ghost.app.gate.GateInstrumentation"
        android:label="GHOST gate"
        android:targetPackage="${applicationId}" />

    <!-- The Compose test rule's host for the gate-targeted instrumented suites (Q25): declared
         in the target app so the content runs in the target process. The gate variant does not
         merge ui-test-manifest (a debug-only dependency), so no conflict here. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false" />
    </application>

</manifest>
