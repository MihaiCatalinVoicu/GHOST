<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only permissions the guarantee matrix can justify. Any addition must reference an ADR. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ADR-20: the periodic sync job is persisted across reboots (JobInfo.setPersisted). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ADR-20: the sync job's network constraint (required from targetSdk 34). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phase 11's media3-exoplayer declares WAKE_LOCK in its manifest; GHOST holds no wake
         locks (no setWakeMode call anywhere; the player is released at every hide and lock,
         design faza13-ux.md §3.3). The permission is removed at the merge so the T15 allowlist
         stays exact — the pre-existing WAKE_LOCK red on the merged manifest (found by Phase 13
         S0b's ui-manifest gate, 2026-10-18) closes with this. -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <!-- Phase 13 design §4.7 (Q12): the camera is used for QR scanning only and is not required —
         a device without one uses the paste fallback (G-U11). -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".GhostApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Phase 13 design §3.4, §4.1 (G-U11): the single activity, the only exported component.
             singleTask + persistNever: the task's persisted base intent carries no link (D7);
             the ghost:// filters accept only the invite, contact and channel hosts — no http(s)
             data, no autoVerify. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:persistableMode="persistNever">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="ghost" android:host="invite" />
                <data android:scheme="ghost" android:host="contact" />
                <data android:scheme="ghost" android:host="channel" />
            </intent-filter>
        </activity>

        <!-- ADR-20: the background sync job. Not exported: only the system binds it, holding
             BIND_JOB_SERVICE (design 5.5). -->
        <service
            android:name="org.ghost.sync.android.SyncJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Phase 9 design 10.7, 21.10 point 7, 13.7 (slice S12): the receiver of the one inexact DM
             alarm. Not exported and without an intent filter: only the app's own explicit,
             immutable PendingIntent reaches it (gate G-DM7, merged-manifest-lint.sh). No new
             permission. -->
        <receiver
            android:name="org.ghost.messaging.android.ExpiryAlarmReceiver"
            android:exported="false" />

        <!-- Phase 11 design §9.2 (slice S5): the isolated image-decoding service. One process
             instance per request (a fresh random instance name per bind); no permissions of its
             own, not exported, no intent filter; GhostApp returns before any wiring in it. -->
        <service
            android:name="org.ghost.media.sandbox.MediaDecodeService"
            android:isolatedProcess="true"
            android:process=":mdec"
            android:exported="false" />

        <!-- Design 11.1 Q7: no exported component besides the launcher. The profile installer's
             exported receiver (protected by DUMP) is removed from the merged manifest. The library
             is a transitive runtime dependency only, so lint cannot resolve the class it removes. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!-- ADR-06, FR-7.11 (Phase 9 review A-3): no call to Google Play services. Compose brings in
             emoji2, whose androidx.startup initializer asks the system font provider (on most
             phones a Google Play services component) for the emoji font 500 ms after the first
             resume: a Binder call that tells Google the app started with UI. The initializer is removed;
             EmojiCompat stays unconfigured and text renders with the platform's own emoji font.
             merged-manifest-lint.sh allowlists the startup initializers that remain. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:ignore="MissingClass"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
